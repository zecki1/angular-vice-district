{
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/vice-district/browser",
  "cleanUrls": true,
  "trailingSlash": false,
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
