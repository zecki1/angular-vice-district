# Copie para `.env` (gitignored) e preencha. `scripts/gerar-ambiente.mjs` transforma
# estas variáveis em `src/environments/ambiente.local.ts` no postinstall/prestart/prebuild.
#
# Nenhuma chave real vai neste arquivo — é a razão de o `.env` existir.

# --- Proxy serverless (BFF) ---
# Vazio = mesmo domínio: o app chama `/api/*` no próprio host. É o caso do deploy
# no Vercel (que executa as funções em `api/`).
# No GitHub Pages (estático) aponte para o deploy do Vercel, que roda o proxy:
#   VITE_API_PROXY_URL=https://vice-district.vercel.app
VITE_API_PROXY_URL=

# --- Supabase (projeto compartilhado `angular-portfolio`) ---
# Vazio = modo demo: o lead da newsletter fica no localStorage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Identifica o app na tabela `leads` (§4.2 do planejamento).
VITE_SUPABASE_PROJECT_SLUG=gta-campaign
VITE_ROLE=demo

# --- Trailer (opcional) ---
# ID do YouTube (apenas o ID, ex: dQw4w9WgXcQ). Vazio = modal mostra o estado de em montagem.
VITE_TRAILER_VIDEO_ID=

# --- Microsoft Clarity (mapa de calor) ---
# Criar projeto em https://clarity.microsoft.com/projects/new e colar o ID
# (o número que vai em clarity.ms/tag/XXXXXXXXXXXXXXXX)
CLARITY_PROJECT_ID=

# =====================================================================
# Chaves de API — usadas APENAS no servidor (funções em `api/`).
# NÃO use o prefixo VITE_: assim elas nunca entram no bundle do browser.
# Configure-as nas Environment Variables do projeto no Vercel (§5).
# =====================================================================

# RAWG (catálogo, lançamentos e detalhe de jogos) — gratuita em https://rawg.io/apidocs
RAWG_API_KEY=

# TMDB (vitrine cinematográfica) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# NewsAPI (opcional: sem ela as notícias vêm só do Reddit)
# https://newsapi.org/register
NEWSAPI_KEY=

# --- Bot humano / uptime (preencher quando subir produção/homologação) ---
BOT_URL=
